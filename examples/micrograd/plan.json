    {
      "id": "s-value",
      "title": "The Value object: numbers that remember",
      "pictures": [
        {
          "id": "b-code",
          "proves": "Run the lines one by one."
        }
      ],
      "moments": [
        {
          "t": 1149,
          "text": "class Value: wraps one number in .data."
        },
        {
          "t": 1185,
          "text": "__repr__ makes it print as Value(data=2.0).",
          "anchor": "#b-code"
        },
        {
          "t": 1221,
          "text": "__add__: a + b becomes a.__add__(b).",
          "anchor": "means:2"
        },
        {
          "t": 1292,
          "text": "__mul__: same idea for ×.",
          "anchor": "means:2"
        },
        {
          "t": 1327,
          "text": "a*b + c is really a.__mul__(b).__add__(c).",
          "action": [
            "demo:builderTo(5)"
          ]
        },
        {
          "t": 1362,
          "text": "_children / _prev: each Value remembers its inputs."
        },
        {
          "t": 1432,
          "text": "_op: each Value remembers the operation that made it."
        },
        {
          "t": 1468,
          "text": "draw_dot: the \"slightly scary\" Graphviz code.",
          "anchor": "#g-build"
        },
        {
          "t": 1573,
          "text": "The round op nodes are only drawing helpers.",
          "anchor": "means:4"
        },
        {
          "t": 1608,
          "text": "Labels: a, b, c, e, d.",
          "anchor": "#g-build"
        },
        {
          "t": 1681,
          "text": "One layer deeper: f = −2 and L = d × f = −8.",
          "anchor": "#g-build",
          "action": [
            "demo:builderTo(7)"
          ]
        },
        {
          "t": 1751,
          "text": "Recap of the forward pass. Backprop is next.",
          "anchor": "#g-build",
          "action": [
            "demo:builderTo(8)"
          ]
        },
        {
          "t": 1786,
          "text": "grad = the derivative of L with respect to each node. dL/dL = 1.",
          "anchor": "means:5"
        },
        {
          "t": 1821,
          "text": "Weights are leaves we want gradients for. Data stays fixed.",
          "anchor": "means:6"
        },
        {
          "t": 1857,
          "text": "self.grad = 0.0: start by assuming \"no effect\".",
          "anchor": "means:5"
        }
