    {
      "id": "s-multi",
      "title": "Many inputs: wiggle one at a time",
      "pictures": [
        {
          "id": "k-a",
          "proves": "The surface is every value of d = a·b + c: a runs left–right, b runs front–back, height is d."
        }
      ],
      "moments": [
        {
          "t": 852,
          "text": "d = a*b + c, with a=2, b=−3, c=10, gives d = 4."
        },
        {
          "t": 887,
          "text": "Fix the inputs and pick a tiny h."
        },
        {
          "t": 923,
          "text": "d1, d2, and slope = (d2 − d1)/h.",
