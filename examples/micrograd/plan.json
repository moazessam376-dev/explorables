        },
        {
          "t": 994,
          "text": "Guess first: does d go up or down when a goes up?"
        },
        {
          "t": 1029,
          "text": "Down: from 4 to 3.9997. The slope is −3.",
          "anchor": "#m-print",
          "action": [
            "[data-nudge=\"a\"]"
          ]
        },
        {
          "t": 1053,
          "text": "The calculus check: the derivative of a·b + c with respect to a is b.",
          "anchor": "means"
        },
        {
          "t": 1089,
          "text": "Bump b instead: the slope is 2, the value of a.",
          "anchor": "means",
          "action": [
            "[data-nudge=\"b\"]"
          ]
        },
        {
          "t": 1124,
          "text": "Bump c: the slope is 1.",
